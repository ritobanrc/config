#!/bin/bash

# Under niri, wsbg owns the wallpapers; just ask it for new ones
if [ "$XDG_CURRENT_DESKTOP" == "niri" ] && pkill -USR1 -x wsbg; then
    exit
fi

source ~/.config/user-dirs.dirs
wallpaper_dir="$XDG_PICTURES_DIR/wall"

if [ "$XDG_CURRENT_DESKTOP" == "niri" ]; then
    outputs=$(niri msg outputs | sed -n 's/^Output .*(\(.*\))$/\1/p')
    swaybg_args=()
else
    export DISPLAY=":0"
    outputs=$(xrandr --query | grep " connected" | cut -d" " -f1)
fi

for m in $outputs; do
    wallpaper_file=$(fd . "$wallpaper_dir" -e "jpg" -e "jpeg" -e "png" -E "nsfw" --type f | shuf -n 1)


    if [ "$1" == "-f" ]; then
        echo "Using file $2"
        wallpaper_file="$2"
    fi

    if [ "$1" == "-p" ]; then
        wallpaper_file=$(fd . "$wallpaper_dir/nsfw" -e "jpg" -e "jpeg" -e "png"  --type f | shuf -n 1)
    fi

    if [ "$1" == "-r" ]; then
        wallpaper_file=$(fd . "$wallpaper_dir" -e "jpg" -e "jpeg" -e "png"  --type f | shuf -n 1)
    fi


    #/usr/bin/notify-send -i $wallpaper_file "$wallpaper_file  applied to monitor $m"

    echo $wallpaper_file

    if [ "$XDG_CURRENT_DESKTOP" == "niri" ]; then
        swaybg_args+=(-o "$m" -i "$wallpaper_file" -m fill)
    elif [ "$(pgrep gnome | wc -l)" -ge 1 ]; then
        gsettings set org.gnome.desktop.background picture-uri-dark "$wallpaper_file"
    else
        xwallpaper --output "$m" --zoom "$wallpaper_file"
    fi

    #xfconf-query -c xfce4-desktop  -p /backdrop/screen0/monitor$m/workspace0/last-image -s "$wallpaper_file"
    #
done

# One swaybg draws every output; start the new one before stopping the old one
# so the screen doesn't flash
if [ ${#swaybg_args[@]} -gt 0 ]; then
    old_swaybg=$(pgrep -x swaybg)
    setsid -f swaybg "${swaybg_args[@]}" >/dev/null 2>&1
    sleep 0.5
    [ -n "$old_swaybg" ] && kill $old_swaybg
fi
