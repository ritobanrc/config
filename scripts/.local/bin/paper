#!/usr/bin/env bash
# Pick a paper from the papers folder (Zotero's linked attachments) with
# fuzzel and open it in zathura.
set -euo pipefail

PAPERS="${PAPERS_DIR:-$HOME/cloud/dropbox-mit/papers}"

name=$(find "$PAPERS" -maxdepth 1 -type f -iname '*.pdf' -printf '%f\n' |
    sed 's/\.pdf$//I' | sort -f |
    fuzzel --dmenu --prompt 'paper> ' --width 100) || exit 0

[[ -f "$PAPERS/$name.pdf" ]] || exit 0
exec zathura "$PAPERS/$name.pdf"
